datasource db {
  provider = "postgresql" // or "sqlite" for rapid local testing: provider = "sqlite", url = "file:./dev.db"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Tenant {
  id             String          @id @default(uuid())
  name           String          @unique
  createdAt      DateTime        @default(now())
  users          User[]
  campaigns      Campaign[]
  securityEvents SecurityEvent[]
  auditLogs      AuditLog[]
}

model User {
  id          String             @id @default(uuid())
  email       String             @unique
  password    String
  name        String
  role        Role               @default(USER)
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns   CampaignAssignee[]
  auditLogs   AuditLog[]
  createdAt   DateTime           @default(now())

  @@index([tenantId])
}

model Campaign {
  id          String             @id @default(uuid())
  title       String
  description String?
  status      CampaignStatus     @default(DRAFT)
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignees   CampaignAssignee[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId])
}

model CampaignAssignee {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model SecurityEvent {
  id          String      @id @default(uuid())
  title       String
  eventType   String
  severity    Severity
  status      EventStatus @default(OPEN)
  description String
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([tenantId, severity, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  ipAddress String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId])
}